{
  "name": "beyaz-yaka",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply beyaz-yaka-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply beyaz-yaka-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "firebase": "^13.2.0",
    "jose": "^6.2.17",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0",
    "@cloudflare/workers-types": "^5.20261110.1"
  }
}
